# Paperclip runtime artifacts
07_PAPERCLIP/**/*.log
07_PAPERCLIP/**/.env
07_PAPERCLIP/**/__pycache__/

# Paperclip company package: agents/ and skills/ are regenerable copies of
# library/ via 07_PAPERCLIP/scripts/sync_company.py — don't version the dupes.
# The unique config (.paperclip.yaml, COMPANY.md, teams/, projects/) IS tracked.
07_PAPERCLIP/companies/*/agents/
07_PAPERCLIP/companies/*/skills/

# Vendored tools (own git repos / huge installs — never commit)
ComfyUI/
OpenVoice/

# Generated production output and runtime state (regenerable, multi-GB)
05_PROJECTS/
06_SHARED_ASSETS/
08_RENDER_FARM/

# Manim render caches (regenerable build artifacts — see AGENTS.md)
media/
.manim_cache/

# Manim render output dropped into curriculum track asset dirs (regenerable)
02_CURRICULUM/*/assets/

# Business unit working dirs: rendered assets + heavy production runs (regenerable).
# Layout: business_units/<company>/<unit>/. The per-unit BRIEF.md, knowledge/, and
# production/README.md ARE tracked.
business_units/*/*/assets/
business_units/*/*/production/*/
*.db
*.db-wal
*.db-shm
.pids/

# Transient editor / build artifacts + personal notes (never commit)
.obsidian/workspace.json
.obsidian/graph.json
01_SKILLS/compiled_lesson_blueprint.json
03_ASSETS/test_*.png
My ideas/

# Generated skills manifest (regenerable) + ingest drop-zone (transient)
07_PAPERCLIP/scripts/skills_manifest.json
02_CURRICULUM/raw_sources/

# Studio backups (local fallback when RAID unmounted)
.backups/
client_secrets.json
client_secret*.json
token.json
*-token.json
trends.yaml

# Node / Google quickstart artifacts (not part of the Python studio)
node_modules/
package.json
package-lock.json
auth_test.js

# Regenerable KB cross-reference cache
**/.kb/graph.json
