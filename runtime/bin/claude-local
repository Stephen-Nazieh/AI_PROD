#!/bin/bash
# claude-local — Project-local Claude Code CLI wrapper (HYBRID routing).
#
# Routing:
#   default              → local MLX proxy (:8003)  — cheap/local, most agents
#   CLAUDE_USE_API=1     → Kimi Code cloud API (Anthropic-compatible) — quality
#                          tier for the writer agents. KIMI_API_KEY is read from
#                          .env so it never lives in agent adapter configs.
#
# Usage:
#   claude-local -p "prompt"                        # local MLX
#   CLAUDE_USE_API=1 claude-local -p "prompt"       # Kimi (kimi-for-coding)

set -e

PROJECT_ROOT="/Users/nazeera/Documents/AI_PRODUCER"
export CLAUDE_CODE_SKIP_UPDATE_CHECK="1"

CLAUDE_BIN="${CLAUDE_BIN:-/Users/nazeera/.local/bin/claude}"
if [[ ! -x "$CLAUDE_BIN" ]]; then
    echo "Error: Claude Code CLI not found at $CLAUDE_BIN" >&2
    echo "Install from: https://docs.anthropic.com/en/docs/agents-and-tools/claude-code/overview" >&2
    exit 1
fi

if [[ "${CLAUDE_USE_API:-0}" == "1" ]]; then
    # ── Cloud mode: Kimi Code (Anthropic-compatible) ────────────────────────────
    # Quality tier for the writer agents. Key lives in .env (gitignored), never in
    # agent adapter configs. Override endpoint/model via KIMI_BASE_URL/ANTHROPIC_MODEL.
    _kimi="$(grep -E '^KIMI_API_KEY=' "$PROJECT_ROOT/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | xargs)"
    if [[ -z "$_kimi" ]]; then
        echo "Error: CLAUDE_USE_API=1 but KIMI_API_KEY is not set in $PROJECT_ROOT/.env" >&2
        exit 1
    fi
    export ANTHROPIC_BASE_URL="${KIMI_BASE_URL:-https://api.kimi.com/coding}"
    export ANTHROPIC_AUTH_TOKEN="$_kimi"   # Kimi authenticates via the bearer token
    export ANTHROPIC_API_KEY=""            # not x-api-key
    export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-kimi-for-coding}"
    # Raise the output cap so longer scripts finish instead of truncating (the QA
    # gate was correctly rejecting cut-off scripts).
    export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-8000}"
    exec "$CLAUDE_BIN" "$@"
fi

# ── Local mode: MLX proxy (:8003) ───────────────────────────────────────────────
export ANTHROPIC_BASE_URL="http://127.0.0.1:8003"
export ANTHROPIC_AUTH_TOKEN="local"
export ANTHROPIC_API_KEY=""   # prevent the CLI from trying to auth with the cloud

if ! curl -sf http://127.0.0.1:8003/health > /dev/null 2>&1; then
    echo "Warning: Local MLX proxy (:8003) is not running." >&2
    echo "Start it with: $PROJECT_ROOT/runtime/startup/start_model_servers.sh" >&2
    echo "Falling back to Anthropic cloud API (if an API key is set in the env)." >&2
    unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
fi

exec "$CLAUDE_BIN" "$@"
